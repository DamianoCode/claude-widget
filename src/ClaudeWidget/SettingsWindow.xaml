<Window x:Class="ClaudeWidget.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Claude Code widget — ustawienia" Width="460" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Topmost="True"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" UseLayoutRounding="True">
  <Window.Resources>
    <Style x:Key="Section" TargetType="TextBlock">
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,14,0,6"/>
    </Style>
    <Style x:Key="Label" TargetType="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0,4,12,4"/>
    </Style>
    <Style x:Key="Note" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#6B6B6B"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Margin" Value="0,2,0,4"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="10,3"/>
      <Setter Property="Margin" Value="6,3,0,3"/>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Margin" Value="0,3"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Margin" Value="0,4"/>
    </Style>
  </Window.Resources>

  <StackPanel Margin="20,6,20,16">
    <TextBlock Text="Dźwięki" Style="{StaticResource Section}"/>
    <CheckBox x:Name="SoundsCheck" Content="Graj dźwięk, gdy sesja czeka albo ma nowy wynik"/>
    <Grid Margin="0,4,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition/>
        <RowDefinition/>
        <RowDefinition/>
        <RowDefinition/>
      </Grid.RowDefinitions>
      <TextBlock Text="Sesja czeka" Style="{StaticResource Label}"/>
      <ComboBox x:Name="WaitingSound" Grid.Column="1"/>
      <Button x:Name="WaitingPlay" Grid.Column="2" Content="▶" ToolTip="Odsłuchaj"/>
      <TextBlock Grid.Row="1" Text="Nowy wynik" Style="{StaticResource Label}"/>
      <ComboBox x:Name="DoneSound" Grid.Row="1" Grid.Column="1"/>
      <Button x:Name="DonePlay" Grid.Row="1" Grid.Column="2" Content="▶" ToolTip="Odsłuchaj"/>
      <TextBlock Grid.Row="2" Text="Głośność" Style="{StaticResource Label}"/>
      <Slider x:Name="VolumeSlider" Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="100"
              TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
      <TextBlock x:Name="VolumeText" Grid.Row="2" Grid.Column="2" Width="42" TextAlignment="Right"
                 VerticalAlignment="Center"/>
      <TextBlock Grid.Row="3" Text="Powtórzenia" Style="{StaticResource Label}"/>
      <ComboBox x:Name="RepeatCombo" Grid.Row="3" Grid.Column="1"
                ToolTip="Seria próśb o zgodę w jednej sesji gra dźwięk najwyżej raz na tyle czasu"/>
    </Grid>
    <TextBlock Style="{StaticResource Note}"
               Text="Własny dźwięk: plik WAV, MP3, WMA albo M4A. Wybrany dźwięk od razu gra na próbę."/>

    <TextBlock Text="Powiadomienia" Style="{StaticResource Section}"/>
    <CheckBox x:Name="NotificationsCheck" Content="Pokazuj powiadomienia Windows"/>
    <DockPanel Margin="0,6,0,0">
      <TextBlock x:Name="MuteStatus" DockPanel.Dock="Top" Margin="0,0,0,2"/>
      <WrapPanel x:Name="MuteButtons" Margin="-6,0,0,0"/>
    </DockPanel>
    <TextBlock Style="{StaticResource Note}"
               Text="Wyciszenie wyłącza dźwięki i powiadomienia na jakiś czas; potem wracają same."/>

    <TextBlock Text="Widżet" Style="{StaticResource Section}"/>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition/>
        <RowDefinition/>
        <RowDefinition/>
      </Grid.RowDefinitions>
      <TextBlock Text="Skrót klawiszowy" Style="{StaticResource Label}"/>
      <TextBox x:Name="HotkeyBox" Grid.Column="1" IsReadOnly="True" IsReadOnlyCaretVisible="False"
               VerticalContentAlignment="Center" Padding="4,2" Margin="0,3"
               ToolTip="Kliknij i naciśnij nową kombinację klawiszy"/>
      <Button x:Name="HotkeyDefault" Grid.Column="2" Content="Domyślny"/>
      <Button x:Name="HotkeyOff" Grid.Column="3" Content="Wyłącz"/>
      <TextBlock x:Name="HotkeyStatus" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3"
                 Style="{StaticResource Note}"/>
      <TextBlock Grid.Row="2" Text="Krycie" Style="{StaticResource Label}"/>
      <Slider x:Name="OpacitySlider" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Minimum="30" Maximum="100"
              TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
      <TextBlock x:Name="OpacityText" Grid.Row="2" Grid.Column="3" Width="42" TextAlignment="Right"
                 VerticalAlignment="Center"/>
    </Grid>
    <CheckBox x:Name="FullscreenCheck" Content="Chowaj widżet, gdy na jego monitorze coś jest na pełnym ekranie"/>

    <DockPanel Margin="0,18,0,0" LastChildFill="False">
      <Button x:Name="OpenFileButton" DockPanel.Dock="Left" Margin="0,3" Content="Otwórz plik ustawień"/>
      <Button x:Name="CloseButton" DockPanel.Dock="Right" Content="Zamknij" IsCancel="True" MinWidth="80"/>
    </DockPanel>
  </StackPanel>
</Window>
