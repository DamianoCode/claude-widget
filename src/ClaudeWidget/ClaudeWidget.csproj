<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Ikona w zasobniku (NotifyIcon) jest z WinForms. -->
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>ClaudeWidget</AssemblyName>
    <RootNamespace>ClaudeWidget</RootNamespace>
    <!-- Ikona w Eksploratorze, menu Start i na skrótach; ikona w zasobniku rysuje się w kodzie (kolor stanu). -->
    <ApplicationIcon>Assets\widget.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms i WPF mają typy o tych samych nazwach (Application, Color...); domyślnie obowiązuje WPF. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.0" />
    <!-- Win32_Process (CommandLine, ParentProcessId): to znajdywać okno hosta sesji i sprzątnąć
         procesy widżetu z PowerShella, tak jak dawniej robił to Get-CimInstance w widget.ps1.
         Nie ma bezpiecznego API .NET do cudzej listy argumentów ani PPID bez tego. -->
    <PackageReference Include="System.Management" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ClaudeWidget.Core\ClaudeWidget.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Custom Main w App.xaml.cs (Velopack musi ruszyć przed startem WPF) zamiast domyślnego z App.xaml. -->
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

</Project>
