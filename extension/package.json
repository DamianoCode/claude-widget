{
  "name": "claude-widget-bridge",
  "displayName": "Claude Code widget bridge",
  "description": "Po kliknięciu sesji w widżecie Claude Code pokazuje terminal VS Code, w którym ona działa.",
  "publisher": "damianocode",
  "version": "1.1.0",
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/DamianoCode/claude-widget"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "ui"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "compile": "tsc -p .",
    "test": "npm run compile && node --test \"out/test/**/*.test.js\"",
    "package": "npm run compile && vsce package --no-dependencies -o ClaudeWidgetBridge.vsix"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "~1.90.0",
    "@vscode/vsce": "^4.0.0",
    "typescript": "~5.9.0"
  }
}
